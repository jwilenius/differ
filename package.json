{
  "name": "differ",
  "displayName": "Differ",
  "description": "IntelliJ-style Git commit diff viewer and three-way merge conflict resolver for VS Code",
  "version": "0.3.0",
  "publisher": "local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jwilenius/differ.git"
  },
  "license": "MIT",
  "icon": "media/differ-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "differ.openMergeView",
        "title": "Open Three-Way Merge View",
        "category": "Differ",
        "icon": "$(git-merge)"
      },
      {
        "command": "differ.resolveConflicts",
        "title": "Resolve Conflicts",
        "category": "Differ",
        "icon": "$(git-merge)"
      },
      {
        "command": "differ.resolveConflictInFile",
        "title": "Resolve Conflict in Differ",
        "category": "Differ"
      },
      {
        "command": "differ.openHistory",
        "title": "Open Git History",
        "category": "Differ",
        "icon": "$(history)"
      },
      {
        "command": "differ.refreshHistory",
        "title": "Refresh Git History",
        "category": "Differ",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "differLauncher",
          "title": "Differ",
          "icon": "media/differ-activitybar.svg"
        }
      ],
      "panel": [
        {
          "id": "differHistory",
          "title": "Differ",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "differHistory": [
        {
          "type": "webview",
          "id": "differ.history",
          "name": "Git History"
        }
      ],
      "differLauncher": [
        {
          "id": "differ.launcher",
          "name": "Launcher"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "differ.launcher",
        "contents": "Differ's Git History opens in the bottom panel.\n[Open Git History](command:differ.openHistory)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "differ.openMergeView",
          "when": "differ.hasConflicts",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "differ.resolveConflictInFile",
          "when": "!explorerResourceIsFolder && resourcePath in differ.conflictedFiles",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "differ.resolveConflictInFile",
          "when": "resourcePath in differ.conflictedFiles",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "differ.resolveConflictInFile",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "differ.refreshHistory",
          "when": "view == differ.history",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "differ.openMergeView",
          "when": "editorIsOpen"
        },
        {
          "command": "differ.resolveConflicts"
        },
        {
          "command": "differ.resolveConflictInFile",
          "when": "false"
        },
        {
          "command": "differ.openHistory"
        },
        {
          "command": "differ.refreshHistory"
        }
      ]
    },
    "configuration": {
      "title": "Differ",
      "properties": {
        "differ.wordLevelHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the changed words inside modified lines."
        },
        "differ.historyDiffViewer": {
          "type": "string",
          "enum": [
            "intellij",
            "native"
          ],
          "enumDescriptions": [
            "Open changed files from Git History in Differ's IntelliJ-style side-by-side diff.",
            "Open changed files from Git History in VS Code's built-in diff editor."
          ],
          "default": "intellij",
          "description": "Which diff viewer opens text files from the Git History panel."
        }
      }
    },
    "colors": [
      {
        "id": "differ.diffAddedBackground",
        "description": "Two-way diff: added lines, their line numbers and ribbons.",
        "defaults": {
          "dark": "#2f4337",
          "light": "#e3f3e6",
          "highContrast": "#1b3323"
        }
      },
      {
        "id": "differ.diffDeletedBackground",
        "description": "Two-way diff: deleted lines, their line numbers and ribbons.",
        "defaults": {
          "dark": "#484a4a",
          "light": "#ebebeb",
          "highContrast": "#3a3a3a"
        }
      },
      {
        "id": "differ.diffModifiedBackground",
        "description": "Two-way diff: modified lines, their line numbers and ribbons.",
        "defaults": {
          "dark": "#28323d",
          "light": "#e6eefb",
          "highContrast": "#1b2a3d"
        }
      },
      {
        "id": "differ.diffModifiedWordBackground",
        "description": "Two-way diff: changed words inside modified lines.",
        "defaults": {
          "dark": "#3e546e",
          "light": "#c5d7f5",
          "highContrast": "#2e5788"
        }
      },
      {
        "id": "differ.mergeConflictBackground",
        "description": "Merge view: lines of a conflict (both sides changed the block).",
        "defaults": {
          "dark": "#241f1f",
          "light": "#fff0ec",
          "highContrast": "#3d2421"
        }
      },
      {
        "id": "differ.mergeConflictStrongBackground",
        "description": "Merge view: a conflict's gutters, result line numbers, ribbons and changed words.",
        "defaults": {
          "dark": "#312623",
          "light": "#fbd4ca",
          "highContrast": "#6b3a33"
        }
      },
      {
        "id": "differ.mergeAddedBackground",
        "description": "Merge view: lines a side added.",
        "defaults": {
          "dark": "#25322a",
          "light": "#e3f3e6",
          "highContrast": "#1b3323"
        }
      },
      {
        "id": "differ.mergeAddedStrongBackground",
        "description": "Merge view: an added block's gutters, result line numbers and ribbons.",
        "defaults": {
          "dark": "#25322a",
          "light": "#c9e8cf",
          "highContrast": "#2b5537"
        }
      },
      {
        "id": "differ.mergeDeletedBackground",
        "description": "Merge view: lines a side deleted.",
        "defaults": {
          "dark": "#363737",
          "light": "#ebebeb",
          "highContrast": "#3a3a3a"
        }
      },
      {
        "id": "differ.mergeDeletedStrongBackground",
        "description": "Merge view: a deleted block's gutters, result line numbers and ribbons.",
        "defaults": {
          "dark": "#363737",
          "light": "#d6d6d6",
          "highContrast": "#555555"
        }
      },
      {
        "id": "differ.mergeModifiedBackground",
        "description": "Merge view: lines a side modified.",
        "defaults": {
          "dark": "#222930",
          "light": "#edf3fd",
          "highContrast": "#1b2a3d"
        }
      },
      {
        "id": "differ.mergeModifiedStrongBackground",
        "description": "Merge view: a modified block's gutters, result line numbers, ribbons and changed words.",
        "defaults": {
          "dark": "#2f3d50",
          "light": "#c5d7f5",
          "highContrast": "#2e5788"
        }
      }
    ]
  },
  "scripts": {
    "package": "npm run build && vsce package --no-dependencies --skip-license",
    "build": "node -e \"const fs = require('fs'); fs.mkdirSync('dist', { recursive: true }); fs.copyFileSync('node_modules/vscode-oniguruma/release/onig.wasm', 'dist/onig.wasm')\" && esbuild src/host/vscode/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --main-fields=module,main",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deps": "npm audit --audit-level=high && node scripts/check-osv-malware.mjs",
    "check:signatures": "npm audit signatures"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "jsonc-parser": "^3.3.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
