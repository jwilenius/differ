{
  "name": "jw-differ",
  "displayName": "jw-differ",
  "description": "IntelliJ-style Git commit diff viewer and three-way merge conflict resolver for VS Code",
  "version": "0.5.0",
  "publisher": "jwilenius",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jwilenius/differ.git"
  },
  "license": "MIT",
  "icon": "media/differ-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jwDiffer.openMergeView",
        "title": "Open Three-Way Merge View",
        "category": "jw-differ",
        "icon": "$(git-merge)"
      },
      {
        "command": "jwDiffer.resolveConflicts",
        "title": "Resolve Conflicts",
        "category": "jw-differ",
        "icon": "$(git-merge)"
      },
      {
        "command": "jwDiffer.resolveConflictInFile",
        "title": "Resolve Conflict in jw-differ",
        "category": "jw-differ"
      },
      {
        "command": "jwDiffer.openHistory",
        "title": "Open Git History",
        "category": "jw-differ",
        "icon": {
          "light": "media/differ-history-light.svg",
          "dark": "media/differ-history-dark.svg"
        }
      },
      {
        "command": "jwDiffer.refreshHistory",
        "title": "Refresh Git History",
        "category": "jw-differ",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "jwDifferHistory",
          "title": "jw-differ",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "jwDifferHistory": [
        {
          "type": "webview",
          "id": "jwDiffer.history",
          "name": "Git History"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "jwDiffer.openMergeView",
          "when": "jwDiffer.hasConflicts",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "jwDiffer.resolveConflictInFile",
          "when": "!explorerResourceIsFolder && resourcePath in jwDiffer.conflictedFiles",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "jwDiffer.resolveConflictInFile",
          "when": "resourcePath in jwDiffer.conflictedFiles",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "jwDiffer.resolveConflictInFile",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "jwDiffer.openHistory",
          "when": "scmProvider == git",
          "group": "navigation@50"
        }
      ],
      "view/title": [
        {
          "command": "jwDiffer.refreshHistory",
          "when": "view == jwDiffer.history",
          "group": "navigation"
        },
        {
          "command": "jwDiffer.openHistory",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@50"
        }
      ],
      "commandPalette": [
        {
          "command": "jwDiffer.openMergeView",
          "when": "editorIsOpen"
        },
        {
          "command": "jwDiffer.resolveConflicts"
        },
        {
          "command": "jwDiffer.resolveConflictInFile",
          "when": "false"
        },
        {
          "command": "jwDiffer.openHistory"
        },
        {
          "command": "jwDiffer.refreshHistory"
        }
      ]
    },
    "configuration": {
      "title": "jw-differ",
      "properties": {
        "jwDiffer.wordLevelHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the changed words inside modified lines."
        },
        "jwDiffer.historyDiffViewer": {
          "type": "string",
          "enum": [
            "intellij",
            "native"
          ],
          "enumDescriptions": [
            "Open changed files from Git History in jw-differ's IntelliJ-style side-by-side diff.",
            "Open changed files from Git History in VS Code's built-in diff editor."
          ],
          "default": "intellij",
          "description": "Which diff viewer opens text files from the Git History panel."
        },
        "jwDiffer.historyMaxCommits": {
          "type": "number",
          "default": 20000,
          "minimum": 100,
          "description": "The most commits the Git History panel loads; it shows the newest ones across the listed branches and tags and notes when older history is left out. Very large values can make VS Code's extension host run out of memory on big repositories."
        }
      }
    },
    "colors": [
      {
        "id": "jwDiffer.diffAddedBackground",
        "description": "Two-way diff: added lines, their line numbers and ribbons.",
        "defaults": {
          "dark": "#2f4337",
          "light": "#e3f3e6",
          "highContrast": "#1b3323"
        }
      },
      {
        "id": "jwDiffer.diffDeletedBackground",
        "description": "Two-way diff: deleted lines, their line numbers and ribbons.",
        "defaults": {
          "dark": "#484a4a",
          "light": "#ebebeb",
          "highContrast": "#3a3a3a"
        }
      },
      {
        "id": "jwDiffer.diffModifiedBackground",
        "description": "Two-way diff: modified lines, their line numbers and ribbons.",
        "defaults": {
          "dark": "#28323d",
          "light": "#e6eefb",
          "highContrast": "#1b2a3d"
        }
      },
      {
        "id": "jwDiffer.diffModifiedWordBackground",
        "description": "Two-way diff: changed words inside modified lines.",
        "defaults": {
          "dark": "#3e546e",
          "light": "#c5d7f5",
          "highContrast": "#2e5788"
        }
      },
      {
        "id": "jwDiffer.mergeConflictBackground",
        "description": "Merge view: lines of a conflict (both sides changed the block).",
        "defaults": {
          "dark": "#241f1f",
          "light": "#fff0ec",
          "highContrast": "#3d2421"
        }
      },
      {
        "id": "jwDiffer.mergeConflictStrongBackground",
        "description": "Merge view: a conflict's gutters, result line numbers, ribbons and changed words.",
        "defaults": {
          "dark": "#312623",
          "light": "#fbd4ca",
          "highContrast": "#6b3a33"
        }
      },
      {
        "id": "jwDiffer.mergeAddedBackground",
        "description": "Merge view: lines a side added.",
        "defaults": {
          "dark": "#25322a",
          "light": "#e3f3e6",
          "highContrast": "#1b3323"
        }
      },
      {
        "id": "jwDiffer.mergeAddedStrongBackground",
        "description": "Merge view: an added block's gutters, result line numbers and ribbons.",
        "defaults": {
          "dark": "#25322a",
          "light": "#c9e8cf",
          "highContrast": "#2b5537"
        }
      },
      {
        "id": "jwDiffer.mergeDeletedBackground",
        "description": "Merge view: lines a side deleted.",
        "defaults": {
          "dark": "#363737",
          "light": "#ebebeb",
          "highContrast": "#3a3a3a"
        }
      },
      {
        "id": "jwDiffer.mergeDeletedStrongBackground",
        "description": "Merge view: a deleted block's gutters, result line numbers and ribbons.",
        "defaults": {
          "dark": "#363737",
          "light": "#d6d6d6",
          "highContrast": "#555555"
        }
      },
      {
        "id": "jwDiffer.mergeModifiedBackground",
        "description": "Merge view: lines a side modified.",
        "defaults": {
          "dark": "#222930",
          "light": "#edf3fd",
          "highContrast": "#1b2a3d"
        }
      },
      {
        "id": "jwDiffer.mergeModifiedStrongBackground",
        "description": "Merge view: a modified block's gutters, result line numbers, ribbons and changed words.",
        "defaults": {
          "dark": "#2f3d50",
          "light": "#c5d7f5",
          "highContrast": "#2e5788"
        }
      }
    ]
  },
  "scripts": {
    "package": "npm run build && vsce package --no-dependencies --skip-license",
    "build": "node -e \"const fs = require('fs'); fs.mkdirSync('dist', { recursive: true }); fs.copyFileSync('node_modules/vscode-oniguruma/release/onig.wasm', 'dist/onig.wasm')\" && esbuild src/host/vscode/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --main-fields=module,main",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deps": "npm audit --audit-level=high && node scripts/check-osv-malware.mjs",
    "check:signatures": "npm audit signatures"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "jsonc-parser": "^3.3.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
